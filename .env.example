# TrustShield AI — Cyber Resilience | Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to Git.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# --- CORS (Frontend URL) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Threat Intelligence APIs ---
# URLhaus API (no key required for basic lookups, but set base URL)
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/

# PhishTank (requires free account registration at https://www.phishtank.com/api_info.php)
# Leave empty to disable PhishTank integration
PHISHTANK_API_KEY=
PHISHTANK_API_URL=https://checkurl.phishtank.com/checkurl/

# --- HTTP Client Settings ---
THREAT_INTEL_TIMEOUT_SECONDS=5
THREAT_INTEL_ENABLED=true

# --- Rate Limiting (future use) ---
RATE_LIMIT_PER_MINUTE=60
